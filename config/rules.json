[
  {
    "name": "Interview Emails from Tenmiles",
    "conditions_predicate": "all",
    "conditions": [
      {
        "field": "From",
        "predicate": "contains",
        "value": "tenmiles.com"
      },
      {
        "field": "Subject",
        "predicate": "contains",
        "value": "Interview"
      },
      {
        "field": "Date received",
        "predicate": "is_less_than",
        "value": 2
      }
    ],
    "actions": [
      {
        "action": "move_message",
        "destination": "Inbox"
      },
      {
        "action": "mark_as_read"
      }
    ]
  },
  {
    "name": "Mark emails from boss as read",
    "conditions_predicate": "All",
    "conditions": [
      {
        "field": "From",
        "predicate": "Contains",
        "value": "kommurisiddhi@gmail.com"
      }
    ],
    "actions": ["mark_as_read"]
  },
  {
    "name": "Move promotional emails",
    "conditions_predicate": "Any",
    "conditions": [
      {
        "field": "Subject",
        "predicate": "Contains",
        "value": "Sale"
      },
      {
        "field": "Subject",
        "predicate": "Contains",
        "value": "Promotion"
      }
    ],
    "actions": ["move_to:STARRED"]
  },
  {
    "name": "Flag old unread emails",
    "conditions_predicate": "All",
    "conditions": [
      {
        "field": "Received",
        "predicate": "Greater than",
        "value": "30"
      }
    ],
    "actions": ["mark_as_unread"]
  }
]
